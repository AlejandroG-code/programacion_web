# Entorno de Ejecución
NODE_ENV=development
PORT=3000

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=personal_finances_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false

# Autenticación y Seguridad
JWT_SECRET=super_secure_jwt_secret_key_change_in_production_min_32_characters
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secure_cookie_secret_change_in_production

# Configuración Financiera
DEFAULT_BASE_CURRENCY=USD
